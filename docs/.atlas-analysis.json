{
  "projectType": "cli-tool",
  "projectName": "llmwiki",
  "projectDescription": "A knowledge compiler that turns raw sources — URLs, files, and session exports — into a persistent, interlinked markdown wiki with semantic search, citation tracing, and MCP agent integration.",
  "theme": "luma",
  "primaryColor": "#5B6AD0",
  "lightColor": "#EEF0FF",
